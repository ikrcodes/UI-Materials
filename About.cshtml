@{
    Layout = "~/Views/Shared/GeneralMaster.cshtml";
    ViewBag.Title = "About";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    :root {
        --primary: #dc3545; /* danger */
        --secondary: #fff5f5; /* light background */
        --accent: #ff4d6d; /* accent */
        --dark: #1f2937; /* soft black */
        --text: #374151;
        --white: #ffffff;
    }

    body {
        background: var(--secondary);
        color: var(--text);
        font-family: 'Work Sans', sans-serif;
    }

    /* ✅ HERO */
    .about-hero {
        position: relative;
        min-height: 260px;
        background: url('/Content/MyImage/2.jpg') center/cover no-repeat;
        border-radius: 0 0 26px 26px;
        overflow: hidden;
    }

        .about-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(220,53,69,0.85), rgba(31,41,55,0.75));
        }

    .hero-content {
        position: relative;
        z-index: 2;
        padding: 55px 16px;
        text-align: center;
        color: var(--white);
    }

        .hero-content h1 {
            font-weight: 900;
            font-size: 28px;
            margin-bottom: 8px;
        }

        .hero-content p {
            margin-bottom: 0;
            opacity: 0.9;
            font-size: 15px;
        }

    /* ✅ Section */
    .section-wrap {
        padding: 50px 0;
    }

    .section-title {
        font-weight: 900;
        color: var(--dark);
    }

    .section-subtitle {
        color: #6b7280;
        font-size: 15px;
    }

    /* ✅ Card */
    .theme-card {
        background: var(--white);
        border-radius: 18px;
        border: 1px solid rgba(220, 53, 69, 0.12);
        box-shadow: 0px 10px 28px rgba(31, 41, 55, 0.08);
        transition: 0.3s ease;
        overflow: hidden;
        height: 100%;
    }

        .theme-card:hover {
            transform: translateY(-6px);
            box-shadow: 0px 16px 45px rgba(31, 41, 55, 0.14);
            border-color: rgba(220, 53, 69, 0.25);
        }

    /* ✅ Icon circle */
    .icon-circle {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: var(--white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0px 10px 22px rgba(220,53,69,0.26);
    }

    /* ✅ Image */
    .about-img {
        width: 100%;
        height: 100%;
        max-height: 320px;
        object-fit: cover;
        border-radius: 18px;
        border: 4px solid rgba(220, 53, 69, 0.18);
        box-shadow: 0px 14px 35px rgba(0, 0, 0, 0.15);
    }

    /* ✅ Badge */
    .badge-theme {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 30px;
        font-weight: 800;
        font-size: 13px;
        background: rgba(220,53,69,0.12);
        color: var(--primary);
    }

    /* ✅ Stats */
    .stat-card {
        background: var(--white);
        border-radius: 18px;
        border: 1px solid rgba(220,53,69,0.14);
        padding: 22px;
        position: relative;
        overflow: hidden;
        height: 100%;
        box-shadow: 0px 10px 26px rgba(0,0,0,0.08);
    }

        .stat-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -45px;
            top: -45px;
            background: rgba(255,77,109,0.15);
            border-radius: 50%;
        }

        .stat-card h3 {
            font-weight: 900;
            color: var(--primary);
            margin-bottom: 4px;
            position: relative;
            z-index: 2;
        }

        .stat-card p {
            margin: 0;
            color: #6b7280;
            position: relative;
            z-index: 2;
        }

    /* ✅ Buttons */
    .btn-primary-custom {
        background: var(--primary);
        color: var(--white);
        border: none;
        border-radius: 30px;
        padding: 10px 18px;
        font-weight: 800;
        transition: 0.3s;
    }

        .btn-primary-custom:hover {
            background: #b02a37;
            transform: translateY(-2px);
        }

    .btn-accent-custom {
        background: var(--accent);
        color: var(--white);
        border: none;
        border-radius: 30px;
        padding: 10px 18px;
        font-weight: 800;
        transition: 0.3s;
    }

        .btn-accent-custom:hover {
            background: #ff2e55;
            transform: translateY(-2px);
        }

    /* ✅ CTA */
    .cta-box {
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: var(--white);
        border-radius: 22px;
        padding: 50px 18px;
        text-align: center;
        box-shadow: 0px 16px 45px rgba(220,53,69,0.35);
    }

        .cta-box h2 {
            font-weight: 900;
            margin-bottom: 8px;
            font-size: 26px;
        }

        .cta-box p {
            opacity: 0.9;
            margin-bottom: 18px;
        }

    /* ✅ Mobile First adjustments */
    @@media(min-width:768px) {
        .hero-content h1 {
            font-size: 40px;
        }

        .hero-content p {
            font-size: 16px;
        }

        .about-hero {
            min-height: 360px;
        }

        .cta-box h2 {
            font-size: 34px;
        }
    }
</style>


<!-- ✅ HERO -->
<section class="about-hero">
    <div class="hero-content container">
        <div class="badge-theme mb-2">
            <i class="fa-solid fa-circle-info me-1"></i> About Us
        </div>
        <h1>About Shree Ram Computers</h1>
        <p>Empowering youth with practical computer education and career-ready skills.</p>
    </div>
</section>


<!-- ✅ WHO WE ARE -->
<section class="section-wrap">
    <div class="container">
        <div class="row align-items-center g-4">

            <div class="col-lg-6">
                <span class="badge-theme">
                    <i class="fa-solid fa-building-columns me-1"></i> Who We Are
                </span>
                <h2 class="section-title mt-2">Trusted Computer Training Institute</h2>
                <p class="section-subtitle" style="text-align:justify;">
                    <b>Shree Ram Computers</b> is one of the leading computer training institutes in Sant Kabir Nagar.
                    We focus on <b>practical-oriented</b> and <b>job-focused</b> education to help students build strong skills.
                </p>

                <div class="theme-card p-4 mt-3">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="icon-circle">
                            <i class="fa-solid fa-certificate"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1" style="color:var(--dark);">NIELIT Affiliated</h5>
                            <p class="mb-0 text-muted">
                                We are affiliated with NIELIT (National Institute of Electronics & Information Technology),
                                Ministry of Electronics & IT, Government of India.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="theme-card p-4 mt-3">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="icon-circle">
                            <i class="fa-solid fa-laptop-code"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1" style="color:var(--dark);">Practical Learning</h5>
                            <p class="mb-0 text-muted">
                                Our goal is to prepare students for real-world careers through hands-on learning,
                                expert faculty, and updated modules.
                            </p>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-lg-6">
                <img src="~/Content/MyImage/2.jpg" class="about-img" alt="About Image">
            </div>

        </div>
    </div>
</section>


<!-- ✅ FOUNDER SECTION -->
<section class="section-wrap pt-0">
    <div class="container">
        <div class="row g-4 align-items-center">

            <div class="col-lg-5">
                <div class="theme-card p-4 text-center">
                    <img src="~/Content/MyImage/santo.jpeg" class="about-img" style="max-height:280px;" alt="Founder" />
                    <h4 class="fw-bold mt-3 mb-1" style="color:var(--primary);">
                        <i class="fa-solid fa-user-tie me-1"></i> Mr. Santosh Jaishwal
                    </h4>
                    <p class="text-muted mb-0">Founder - Shree Ram Computers</p>
                </div>
            </div>

            <div class="col-lg-7">
                <span class="badge-theme">
                    <i class="fa-solid fa-book-open me-1"></i> Our Story
                </span>
                <h2 class="section-title mt-2">Established in 2017</h2>
                <p class="section-subtitle" style="text-align:justify;">
                    Shree Ram Computer Centre was established in 2017 and is managed by Pandit Baburam Trivedi Smriti Shiksha Samiti.
                    The institute is located on Sant Kabir Nagar – Mehdawal Road, around 3 km from Khalilabad Railway Station.
                </p>
                <p class="section-subtitle" style="text-align:justify;">
                    We offer various courses such as O Level, ADCA, DCA, DTP, CCC, Tally with GST, HTML, Web Development, Python, IoT and many more.
                    Our center provides both theoretical and practical training with modern lab facilities.
                </p>

                <a href="/Home/Courses" class="btn btn-primary-custom me-2">
                    <i class="fa-solid fa-book me-1"></i> View Courses
                </a>
                <a href="/Home/Contact" class="btn btn-accent-custom">
                    <i class="fa-solid fa-phone me-1"></i> Contact Us
                </a>
            </div>

        </div>
    </div>
</section>


