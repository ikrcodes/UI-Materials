@{
    Layout = "~/Views/Shared/GeneralMaster.cshtml";
    ViewBag.Title = "Home Page";
}

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    :root {
        --primary: #dc3545;          /* danger */
        --secondary: #fff5f5;        /* light red background */
        --accent: #ff4d6d;           /* red-pink accent */
        --dark: #1f2937;             /* soft black (not pure black) */
        --text: #374151;             /* normal text color */
        --white: #ffffff;
    }

    body {
        background: var(--secondary);
        font-family: 'Work Sans', sans-serif;
        color: var(--text);
    }

    /* ✅ HERO SLIDER */
    .hero-slider img {
        height: 550px;
        object-fit: cover;
        filter: brightness(60%);
    }

    .hero-caption {
        background: rgba(31, 41, 55, 0.75);
        padding: 20px;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.15);
        backdrop-filter: blur(6px);
        max-width: 750px;
        margin: auto;
    }

    .hero-caption h2 {
        color: var(--white);
        font-weight: 800;
    }

    .hero-caption p {
        color: rgba(255,255,255,0.85);
        margin-bottom: 16px;
        font-size: 16px;
    }

    /* ✅ Buttons */
    .btn-primary-custom {
        background: var(--primary);
        color: var(--white);
        border: none;
        border-radius: 30px;
        padding: 10px 18px;
        font-weight: 700;
        transition: 0.3s;
    }

    .btn-primary-custom:hover {
        background: #b02a37;
        transform: translateY(-2px);
    }

    .btn-accent-custom {
        background: var(--accent);
        color: var(--white);
        border: none;
        border-radius: 30px;
        padding: 10px 18px;
        font-weight: 700;
        transition: 0.3s;
    }

    .btn-accent-custom:hover {
        background: #ff2e55;
        transform: translateY(-2px);
    }

    .btn-outline-light-custom {
        border: 2px solid var(--white);
        color: var(--white);
        border-radius: 30px;
        padding: 10px 18px;
        font-weight: 700;
        transition: 0.3s;
    }

    .btn-outline-light-custom:hover {
        background: var(--white);
        color: var(--dark);
    }

    /* ✅ Section Title */
    .section-title {
        font-weight: 900;
        color: var(--dark);
    }

    .section-subtitle {
        color: #6b7280;
    }

    /* ✅ Badge Theme */
    .badge-theme {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 30px;
        background: rgba(220, 53, 69, 0.15);
        color: var(--primary);
        font-weight: 800;
        font-size: 13px;
        margin-bottom: 10px;
    }

    /* ✅ Cards (Premium Look) */
    .theme-card {
        border: 1px solid rgba(220, 53, 69, 0.12);
        border-radius: 18px;
        overflow: hidden;
        background: var(--white);
        box-shadow: 0px 10px 28px rgba(31, 41, 55, 0.08);
        transition: all 0.3s ease;
        height: 100%;
    }

        /* Hover Effect */
        .theme-card:hover {
            transform: translateY(-8px);
            box-shadow: 0px 16px 45px rgba(31, 41, 55, 0.14);
            border-color: rgba(220, 53, 69, 0.25);
        }

        /* ✅ Card Body Padding */
        .theme-card .card-body {
            padding: 22px;
        }

    /* ✅ Card Title */
    .card-title-custom {
        font-size: 18px;
        font-weight: 800;
        color: var(--dark);
        margin-bottom: 8px;
    }

    /* ✅ Card Text */
    .theme-card p {
        font-size: 14.5px;
        line-height: 1.6;
        color: #6b7280; /* soft gray */
        margin-bottom: 16px;
    }

    /* ✅ Icon Circle (Balanced & Clean) */
    .icon-circle {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: var(--white);
        font-size: 20px;
        margin-bottom: 14px;
        box-shadow: 0px 10px 22px rgba(220, 53, 69, 0.28);
    }

    /* ✅ Small hover animation on icon */
    .theme-card:hover .icon-circle {
        transform: scale(1.06);
        transition: 0.3s;
    }

    /* ✅ Stats */
    .stats-box {
        border-radius: 18px;
        padding: 24px;
        color: var(--dark);
        background: var(--white);
        border: 1px solid rgba(220,53,69,0.18);
        box-shadow: 0px 10px 26px rgba(0,0,0,0.08);
        position: relative;
        overflow: hidden;
    }

    .stats-box::before {
        content: "";
        position: absolute;
        width: 120px;
        height: 120px;
        right: -40px;
        top: -40px;
        background: rgba(255,77,109,0.18);
        border-radius: 50%;
    }

    .stats-box h2 {
        color: var(--primary);
        font-weight: 900;
    }

    /* ✅ CTA */
    .cta-box {
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: var(--white);
        border-radius: 20px;
        padding: 50px 18px;
        box-shadow: 0px 16px 45px rgba(220,53,69,0.35);
    }

    /* ✅ About Image */
    .about-img {
        border-radius: 18px;
        box-shadow: 0px 12px 35px rgba(0,0,0,0.18);
        border: 4px solid rgba(220,53,69,0.25);
    }

    /* ✅ Responsive */
    @@media(max-width:768px) {
        .hero-slider img {
            height: 320px;
        }
        .hero-caption {
            padding: 14px;
        }
    }
</style>



